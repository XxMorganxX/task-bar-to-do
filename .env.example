# Copy to .env and fill in. Only the first block is required.

# --- Required ---------------------------------------------------------------
SUPABASE_URL=
# Keep this key local: whoever holds it can read and write every row in the todos table.
SUPABASE_KEY=
# Name todos are stored under (todos.user_id).
TODO_USER=

# --- Optional ---------------------------------------------------------------
DEFAULT_TIME_ZONE=America/New_York
# Comma-separated extra users who share the todo list.
TODO_HOUSEHOLD_MEMBERS=
# launchd label of the menu bar agent (default: local.todo-app)
TODO_LAUNCHD_LABEL=
TODO_OVERLAY_PORT=8421

# Obsidian export: mirror todos as notes into <vault>/Todos/
OBSIDIAN_EXPORT_ENABLED=false
OBSIDIAN_VAULT_PATH=
OBSIDIAN_TODOS_SUBDIR=Todos

# AI enrichment of exported notes (people/projects, related todos). Needs OPENAI_API_KEY;
# GEMINI_API_KEY is a fallback for entity extraction.
TODO_GRAPH_ENRICHMENT_ENABLED=false
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Calendar linking (also needs calendars.json; see README)
GOOGLE_SERVICE_ACCOUNT_FILE=
