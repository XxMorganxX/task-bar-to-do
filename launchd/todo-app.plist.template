<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `./todo install` fills in the {{...}} placeholders and copies the result to
     ~/Library/LaunchAgents/{{LABEL}}.plist. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL}}</string>

    <!-- The menu bar app embeds the overlay HTTP server, so one process serves the panel,
         the browser overlay and the API. .env is loaded by todo_app.settings. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>-u</string>
        <string>-m</string>
        <string>todo_app.menubar</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but honour Quit from the menu (exit 0). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Logs go in ~/Library/Logs, never a TCC-protected folder (Desktop, Documents):
         launchd opening a file there fails with EX_CONFIG (78) before the program starts. -->
    <key>StandardOutPath</key>
    <string>{{LOG_FILE}}</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_FILE}}</string>
</dict>
</plist>
